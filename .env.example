# =============================================================================
# Procurement Automation System (ТОО «Электрокомплект»)
# Environment Configuration Template
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=procurement
POSTGRES_PORT=5432
# Primary SQLAlchemy connection URL used by backend container (pointing to 'db' host)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/procurement

# Database connection retry settings (used by backend entrypoint)
DB_MAX_RETRIES=30
DB_RETRY_INTERVAL=2

# --- Backend Service (FastAPI) ---
BACKEND_PORT=8000
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_MINUTES=30
# Allowed CORS origins for browser requests (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OpenAI API (LLM Integration) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15.0
AI_CACHE_TTL_SECONDS=300

# --- Frontend Service (Next.js) ---
FRONTEND_PORT=3000
# Internal Docker network URL for Server-Side Rendering (SSR prefetching)
INTERNAL_API_URL=http://backend:8000/api/v1
# Public URL accessible from the client's web browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Fallback SSR URL
SERVER_API_URL=http://backend:8000/api/v1
# Demo mode flag (true = standalone frontend mock, false = live backend integration)
NEXT_PUBLIC_DEMO_MODE=false
